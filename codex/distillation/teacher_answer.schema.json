{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["packet_id", "teacher", "labels"],
  "properties": {
    "packet_id": {"type": "string"},
    "teacher": {"type": "object", "required": ["model"], "properties": {"model": {"const": "gpt-6-astra"}}},
    "labels": {"type": "array", "minItems": 1, "items": {
      "type": "object",
      "required": ["position_id", "state_sha256", "policy_rankings", "value", "confidence", "claim", "evidence"],
      "properties": {
        "position_id": {"type": "string"}, "state_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "policy_rankings": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["action_index", "rank", "weight"], "properties": {
          "action_index": {"type": "integer", "minimum": 0, "maximum": 4095}, "rank": {"type": "integer", "minimum": 1}, "weight": {"type": "number", "exclusiveMinimum": 0}
        }}},
        "value": {"type": "number", "minimum": -1, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "value_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "claim": {"enum": ["prediction", "forced_win_this_turn", "forced_loss_by_next_turn", "bounded_policy_only"]},
        "value_valid": {"type": "boolean"},
        "label_source": {"type": "string"},
        "evidence": {"type": "string", "minLength": 1, "maxLength": 500},
        "witness": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 4095}}
      }
    }}
  }
}
